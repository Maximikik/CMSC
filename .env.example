# Copy to .env and fill in. Never commit .env.

# Database password. Use letters and digits only (no ; or = characters), for example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 random characters, for example: openssl rand -base64 48
JWT_KEY=

# The address visitors and editors use to reach published sites and uploaded images.
# Local default is fine for trying it out. In production use your own domain, for example https://sites.example.com
PUBLIC_SITES_URL=http://localhost:8081

# Optional: create the first administrator automatically on first start.
# Leave both empty to create it yourself in the browser instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Let anyone with the link create an account? Keep false unless this is a private network.
ALLOW_REGISTRATION=false

# Host ports
EDITOR_PORT=8080
SITES_PORT=8081
